{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every window: the main one, and the ones opened later",
  "windows": ["main", "w-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
